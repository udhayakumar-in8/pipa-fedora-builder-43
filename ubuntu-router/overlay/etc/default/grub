# Ubuntu Router GRUB settings. Run `update-grub` after changing this file.
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=@GRUB_TIMEOUT@
# Ubuntu waits forever at the menu after a failed boot; never do that on a
# headless box.
GRUB_RECORDFAIL_TIMEOUT=@GRUB_TIMEOUT@
GRUB_DISTRIBUTOR="Ubuntu Router"
GRUB_CMDLINE_LINUX_DEFAULT=""
GRUB_CMDLINE_LINUX="@KERNEL_CMDLINE@"
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
GRUB_DISABLE_OS_PROBER=true
GRUB_DISABLE_SUBMENU=y
