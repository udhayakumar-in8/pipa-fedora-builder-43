[Unit]
Description=Router QoS (CAKE traffic shaping)
After=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/router-qos start
ExecStop=/usr/local/sbin/router-qos stop
ExecReload=/usr/local/sbin/router-qos start

[Install]
WantedBy=multi-user.target
