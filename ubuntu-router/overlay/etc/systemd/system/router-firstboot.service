[Unit]
Description=Router first boot setup (SSH host keys)
Before=ssh.service
ConditionPathExists=|!/etc/ssh/ssh_host_ed25519_key
ConditionPathExists=|!/etc/ssh/ssh_host_rsa_key

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/router-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
