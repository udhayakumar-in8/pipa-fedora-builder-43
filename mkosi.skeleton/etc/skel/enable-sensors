#!/bin/bash
# Enable the accelerometer so the screen can rotate automatically.
# Sensors are off by default because they may stop working after suspend;
# pipa-sensor-restart brings them back ~10-15s after waking.

set -e

sudo -S dnf -y install pipa-sensors pipa-sensor-restart iio-sensor-proxy
sudo systemctl enable --now hexagonrpcd-sdsp.service iio-sensor-proxy.service

echo "Sensors enabled. Check rotation with: monitor-sensor"
echo "Log out and back in (or reboot) so the desktop picks up the accelerometer."
