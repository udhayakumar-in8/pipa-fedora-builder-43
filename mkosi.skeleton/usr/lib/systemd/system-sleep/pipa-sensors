#!/bin/bash
# The SDSP sensor hub often doesn't come back after suspend, which breaks
# auto-rotation. ~15s after every resume, check the accelerometer once and
# recover it only if it's missing (it often comes back on its own).
# Runs as a transient unit so systemd-sleep doesn't wait on (or kill) it.

[[ "$1" == "post" ]] || exit 0

systemd-run --no-block --collect --on-active=15 --unit="pipa-sensors-check-$(date +%s)" \
    /usr/libexec/pipa-sensors-watchdog
