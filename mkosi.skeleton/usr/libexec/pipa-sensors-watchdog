#!/bin/bash
# Run every minute by pipa-sensors-watchdog.timer. If iio-sensor-proxy has lost
# the accelerometer, try to recover it with pipa-sensors-resume. Gives up after
# MAX_FAILURES consecutive failed recoveries until the next resume or reboot,
# so a broken sensor hub doesn't get restarted forever.

MAX_FAILURES=5
STATE=/run/pipa-sensors-watchdog.failures

has_accel() {
    busctl get-property net.hadess.SensorProxy /net/hadess/SensorProxy \
        net.hadess.SensorProxy HasAccelerometer 2>/dev/null | grep -q true
}

if has_accel; then
    rm -f "$STATE"
    exit 0
fi

failures=$(cat "$STATE" 2>/dev/null || echo 0)
if (( failures >= MAX_FAILURES )); then
    echo "accelerometer missing; gave up after $failures failed recoveries (resets on resume/reboot)"
    exit 0
fi

echo "accelerometer missing, recovering (previous failures: $failures)"
if /usr/libexec/pipa-sensors-resume; then
    rm -f "$STATE"
else
    echo $((failures + 1)) > "$STATE"
fi
